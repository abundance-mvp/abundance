# Integration Test Configuration
# Copy to .env.integration and fill in real values

# =============================================================================
# SECURITY NOTE: Test images are stored in a PRIVATE bucket with enforced
# public access prevention. Never expose test images publicly - they may
# contain personal items. All access uses time-limited signed URLs.
#
# Test bucket: gs://abundance-test-private
# See: docs/test/TEST-004-ai-pipeline-integration-testing.md
# =============================================================================

# Firebase Project
FIREBASE_PROJECT_ID=abundance-mvp

# Vertex AI Configuration (for Gemini 3 models)
GOOGLE_CLOUD_PROJECT=abundance-mvp
GOOGLE_CLOUD_LOCATION=global

# SerpAPI for Google Lens
SERPAPI_KEY=your-serpapi-key

# For local testing: run 'gcloud auth application-default login'
# This authenticates your local environment to access:
# - Vertex AI APIs
# - Private test bucket (gs://abundance-test-private)
# - Firebase services
