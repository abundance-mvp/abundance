<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Abundance iOS App - Info.plist Template
Created: 2025-11-11
Stage: 4.1 - iOS Project Scaffolding
References:
  - docs/validation/RESEARCH-VALIDATION-stage-4.1.md (Info.plist format verified)
  - docs/tech-stack/Package.swift (iOS 26.0+ target)

Usage:
  1. Copy this file to App/Info.plist
  2. Replace placeholders:
     - $(PRODUCT_BUNDLE_IDENTIFIER) → com.abundance.app (or your custom bundle ID)
     - $(MARKETING_VERSION) → 1.0.0
     - $(CURRENT_PROJECT_VERSION) → 1
  3. Add GoogleService-Info.plist to App/ directory (download from Firebase Console)
  4. Build and run (Xcode will resolve variables automatically)

IMPORTANT: Never commit GoogleService-Info.plist to Git (add to .gitignore)
-->
<plist version="1.0">
<dict>
    <!-- MARK: - Bundle Information -->

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleDisplayName</key>
    <string>Abundance</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>

    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>

    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- MARK: - Minimum iOS Version -->

    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>

    <!-- MARK: - Privacy Permissions -->

    <!-- Camera Permission (Required for CameraFeature) -->
    <key>NSCameraUsageDescription</key>
    <string>Abundance needs access to your camera to capture photos of items for cataloging.</string>

    <!-- Photo Library Permission (Required for photo selection) -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Abundance needs access to your photo library to select existing photos of items to catalog.</string>

    <!-- MARK: - App Capabilities -->

    <!-- SwiftUI Scene Configuration -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- Supported Interface Orientations (iPhone) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Supported Interface Orientations (iPad) -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Launch Screen (SwiftUI) -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchScreenBackground</string>
        <key>UIImageName</key>
        <string>LaunchIcon</string>
    </dict>

    <!-- MARK: - iOS 26 Specific -->

    <!-- Requires Full Screen (false = supports iPad split view) -->
    <key>UIRequiresFullScreen</key>
    <false/>

    <!-- Supports Document Browser (false for cataloging app) -->
    <key>UISupportsDocumentBrowser</key>
    <false/>

    <!-- Status Bar Style -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>

    <!-- MARK: - App Transport Security -->

    <!-- Allow Firebase connections (HTTPS only) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- MARK: - Background Modes (Optional - for future push notifications) -->

    <!-- Uncomment if adding push notifications in Phase 2:
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    -->

    <!-- MARK: - Firebase Configuration (Placeholder) -->

    <!-- Firebase keys are loaded from GoogleService-Info.plist at runtime -->
    <!-- Do NOT add Firebase keys here (security risk if committed to Git) -->
    <!-- Download GoogleService-Info.plist from Firebase Console and add to App/ -->

    <!-- MARK: - App Icon -->

    <!-- App Icon Asset Catalog -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
    </dict>

    <!-- MARK: - Localization -->

    <!-- Default Localization -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
    </array>

</dict>
</plist>
