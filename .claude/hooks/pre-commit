#!/bin/bash
# Claude Code pre-commit hook
# 1. Brand guard (feature/brand-* branches only)
# 2. Validates document references before committing docs changes

set -e

# --- Brand Guard ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"
BRAND_GUARD="$PROJECT_ROOT/scripts/brand-guard.sh"
if [[ -f "$BRAND_GUARD" ]]; then
    bash "$BRAND_GUARD"
fi

# Check if any docs/ files are staged
if git diff --cached --name-only | grep -q "^docs/"; then
    echo "📚 Docs changes detected - validating references..."

    # Check if uv is available
    if ! command -v uv &> /dev/null; then
        echo "⚠️  Warning: 'uv' not found. Install with: curl -LsSf https://astral.sh/uv/install.sh | sh"
        echo "📋 Skipping validation (install uv to enable automatic doc reference checking)"
        exit 0  # Don't block commit, just warn
    fi

    # Run quick validation (links only)
    if uv run scripts/validate_docs.py --quick; then
        echo "✅ Document links validated"
    else
        echo "❌ Document validation failed"
        echo "Run 'uv run scripts/validate_docs.py --verbose' to see details"
        exit 1
    fi
fi

exit 0
