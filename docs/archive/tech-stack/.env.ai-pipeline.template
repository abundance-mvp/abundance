# AI Pipeline Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control

# ============================================================================
# Google Generative AI (Gemini 2.5 Flash-Lite)
# ============================================================================
# Option 1: API Key (for local development)
GOOGLE_API_KEY=your_google_api_key_here

# Option 2: Application Default Credentials (recommended for GCP deployment)
# Leave GOOGLE_API_KEY blank and use gcloud auth:
# gcloud auth application-default login
# OR set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================================================
# Anthropic (Claude Haiku 4.5, Claude Sonnet 4.5)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# SerpAPI (Google Lens visual search)
# ============================================================================
# Pricing: $50 per 5000 searches = $0.01 per search
# Get API key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_api_key_here

# ============================================================================
# UPCitemdb (optional, paid barcode lookup)
# ============================================================================
# Pricing: 100 free calls/day, then $0.002 per call
# Get API key: https://www.upcitemdb.com/wp/api/
# Leave blank to only use Open Food Facts (free, no API key)
UPCITEMDB_API_KEY=your_upcitemdb_api_key_here

# ============================================================================
# GCP Project Configuration
# ============================================================================
GCP_PROJECT_ID=abundance-prod
GCP_REGION=us-central1

# ============================================================================
# Firebase Emulator (for local testing)
# ============================================================================
# Set these when running Firebase Emulator Suite
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ============================================================================
# Cost Tracking
# ============================================================================
# Log API costs to Firestore collection
COST_TRACKING_ENABLED=true
COST_TRACKING_COLLECTION=costs

# ============================================================================
# Error Handling
# ============================================================================
# Dead letter queue for failed items
DEAD_LETTER_QUEUE_COLLECTION=failedItems

# Maximum retry attempts for transient errors
MAX_RETRY_ATTEMPTS=3

# Exponential backoff base delay (milliseconds)
RETRY_BASE_DELAY_MS=1000

# Maximum backoff delay (milliseconds)
RETRY_MAX_DELAY_MS=60000

# ============================================================================
# Feature Flags
# ============================================================================
# Enable Claude Sonnet Batch API (50% cost savings, up to 24h latency)
BATCH_API_ENABLED=false

# Enable barcode detection in Layer 2a (Gemini)
BARCODE_DETECTION_ENABLED=true

# Enable Google Lens visual search in Layer 2b
VISUAL_SEARCH_ENABLED=true

# Enable paid barcode lookup (UPCitemdb) if free lookup fails
PAID_BARCODE_LOOKUP_ENABLED=false

# ============================================================================
# Model Configuration
# ============================================================================
# Override default models (advanced)
# GEMINI_MODEL=gemini-2.5-flash-lite
# CLAUDE_HAIKU_MODEL=claude-haiku-4.5-20250110
# CLAUDE_SONNET_MODEL=claude-sonnet-4.5-20250110

# ============================================================================
# Logging
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable verbose logging for debugging
DEBUG_MODE=false
