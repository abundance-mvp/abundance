# Abundance Backend Environment Variables Template
# Copy this file to .env.development, .env.staging, .env.production

# ====================
# GCP Project Configuration
# ====================
GCP_PROJECT_ID=abundance-dev
GCP_REGION=us-central1

# ====================
# Firebase Configuration
# ====================
FIREBASE_PROJECT_ID=abundance-dev
FIREBASE_STORAGE_BUCKET=abundance-dev.appspot.com

# ====================
# AI Provider API Keys
# ====================

# Anthropic Claude API
# Required for Layer 2b (Claude Haiku parsing) and Layer 3 (Claude Sonnet synthesis)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# SerpAPI Google Lens
# Required for Layer 2b (visual product search)
# Get your API key from: https://serpapi.com/manage-api-key
SERPAPI_KEY=...

# UPCitemdb Barcode Lookup
# Required for Layer 2b (barcode product lookup)
# Get your API key from: https://www.upcitemdb.com/api/explorer
UPCITEMDB_API_KEY=...

# ====================
# Node.js Configuration
# ====================
NODE_ENV=development

# ====================
# Stripe (Phase 2 - Optional for MVP)
# ====================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ====================
# Monitoring (Optional)
# ====================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
